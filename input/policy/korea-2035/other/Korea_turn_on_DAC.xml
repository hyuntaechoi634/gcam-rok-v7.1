<?xml version="1.0" encoding="UTF-8"?>
<scenario>
   <world>
        <region name="South Korea">
            <PrimaryFuelCO2Coef name="airCO2">1</PrimaryFuelCO2Coef>
            <supplysector name="CO2 removal">
                <relative-cost-logit>
                    <logit-exponent fillout="1" year="1975">-3</logit-exponent>
                </relative-cost-logit>
                <output-unit>Mt</output-unit>
                <input-unit>EJ or Mt</input-unit>
                <price-unit>1975$/kg</price-unit>
                <keyword final-energy="industry"/>
                <subsector name="dac">
                    <absolute-cost-logit>
                        <logit-exponent fillout="1" year="1975">-0.036</logit-exponent>
                    </absolute-cost-logit>
                    <share-weight fillout="1" year="1975">1</share-weight>
                    <interpolation-rule apply-to="share-weight" from-year="2015" to-year="2100">
                        <interpolation-function name="fixed"/>
                    </interpolation-rule>
                    <stub-technology name="hightemp DAC NG"/>
                    <stub-technology name="hightemp DAC elec"/>
                    <stub-technology name="lowtemp DAC heatpump"/>
                    <stub-technology name="no DAC">
                        <period year="2015">
                            <share-weight>1</share-weight>
                            <CalDataOutput>
                                <calOutputValue>2000</calOutputValue>
                            </CalDataOutput>
                        </period>
                    </stub-technology>
                    <share-weight fillout="1" year="2015">1</share-weight>
                </subsector>
            </supplysector>
            <supplysector name="process heat dac">
                <relative-cost-logit>
                    <logit-exponent fillout="1" year="1975">-3</logit-exponent>
                </relative-cost-logit>
                <output-unit>EJ</output-unit>
                <input-unit>EJ</input-unit>
                <price-unit>1975$/GJ</price-unit>
                <keyword final-energy="industry"/>
                <subsector name="gas CCS">
                    <relative-cost-logit>
                        <logit-exponent fillout="1" year="1975">-6</logit-exponent>
                    </relative-cost-logit>
                    <share-weight fillout="1" year="1975">1</share-weight>
                    <interpolation-rule apply-to="share-weight" from-year="2015" to-year="2100">
                        <interpolation-function name="fixed"/>
                    </interpolation-rule>
                    <stub-technology name="gas CCS"/>
                </subsector>
            </supplysector>
            <supplysector name="airCO2">
                <relative-cost-logit>
                    <logit-exponent fillout="1" year="1975">-3</logit-exponent>
                </relative-cost-logit>
                <output-unit>Mt</output-unit>
                <input-unit>EJ or Mt</input-unit>
                <price-unit>1975$/kg</price-unit>
                <keyword final-energy="industry"/>
                <subsector name="airCO2">
                    <relative-cost-logit>
                        <logit-exponent fillout="1" year="1975">-6</logit-exponent>
                    </relative-cost-logit>
                    <share-weight fillout="1" year="1975">1</share-weight>
                    <stub-technology name="airCO2"/>
                </subsector>
            </supplysector>
            <energy-final-demand name="CO2 removal">
                <perCapitaBased>0</perCapitaBased>
                <final-energy-consumer/>
                <base-service year="2015">2000</base-service>
                <price-elasticity year="2020">0</price-elasticity>
                <price-elasticity year="2025">0</price-elasticity>
                <price-elasticity year="2030">0</price-elasticity>
                <price-elasticity year="2035">0</price-elasticity>
                <price-elasticity year="2040">0</price-elasticity>
