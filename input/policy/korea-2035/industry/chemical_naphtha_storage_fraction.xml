    <world>
        <region name="South Korea">
            <supplysector name="chemical feedstocks">
                <subsector name="refined liquids">
                    <stub-technology name="refined liquids">
                        <period year="1975">
                            <non-energy-use-capture-component>
                                <remove-fraction>0.90</remove-fraction>
                                <target-gas>CO2</target-gas>
                            </non-energy-use-capture-component>
                        </period>
                        <period year="1990">
